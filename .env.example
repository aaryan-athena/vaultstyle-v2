# Groq API key for the AI-powered "Ask AI" vibe search, the intake note on
# /start, and wishlist screenshot reading on /wishlist.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional — defaults to llama-3.3-70b-versatile if unset.
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional — vision-capable model for /wishlist. Defaults to qwen/qwen3.6-27b.
# GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Microsoft Clarity project id — session recording + heatmaps.
# Get one at https://clarity.microsoft.com/ (Settings → Setup → project id).
# Left blank, Clarity never loads — nothing gets recorded until this is set,
# so leave it unset for local dev and set it only in the production deploy.
VITE_CLARITY_PROJECT_ID=
